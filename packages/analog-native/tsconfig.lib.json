{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "paths": {}
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictTemplates": true,
    "strictInjectionParameters": true
  },
  "include": ["src/**/*.ts", "vite/src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/__fixtures__/**"]
}
