{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmitHelpers": true,
    "noEmitOnError": true,
    "paths": {
      "~/*": ["./src/*"],
      "@nativescript-unified/shared": ["../../packages/shared/src/index.ts"],
      "@nativescript/analog": ["../../packages/analog-native/src/index.ts"],
      "@nativescript/analog/vite": ["../../packages/analog-native/vite/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "references.d.ts", "../../packages/shared/src/**/*.ts"],
  "exclude": ["node_modules", "platforms"]
}

