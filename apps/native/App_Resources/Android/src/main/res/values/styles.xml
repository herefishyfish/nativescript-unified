<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- theme to use FOR launch screen-->
    <style name="LaunchScreenThemeBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="toolbarStyle">@style/NativeScriptToolbarStyle</item>

        <item name="colorPrimary">@color/ns_primary</item>
        <item name="colorPrimaryDark">@color/ns_primaryDark</item>
        <item name="colorAccent">@color/ns_accent</item>

        <item name="android:windowBackground">@drawable/splash_screen</item>

        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="LaunchScreenTheme" parent="LaunchScreenThemeBase">
    </style>

    <!-- theme to use AFTER launch screen is loaded-->
    <style name="AppThemeBase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="toolbarStyle">@style/NativeScriptToolbarStyle</item>
        <!-- The selected top tab, the bottom navigation's active pill, and the surface of the bar and the popup menus. -->
        <item name="colorPrimary">@color/ns_brand_primary</item>
        <item name="colorSecondaryContainer">@color/ns_secondary_container</item>
        <item name="colorSurfaceContainer">@color/ns_surface_container</item>

        <item name="colorPrimaryDark">@color/ns_primaryDark</item>
        <item name="colorAccent">@color/ns_accent</item>

        <!-- Day/night window background, so page transitions and modals never flash Material's default surface. -->
        <item name="android:windowBackground">@color/ns_background</item>
        <item name="android:colorBackground">@color/ns_background</item>
        <!-- Dialogs (ui-dialogs and helm dialogs opened as platform dialogs) in helm's dialog card colours. -->
        <item name="materialAlertDialogTheme">@style/AppAlertDialog</item>
    </style>

    <!-- helm's dialog: bg-popover, rounded-xl (14px), a text-lg font-medium title and muted description text. -->
    <style name="AppAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/ns_surface_container</item>
        <item name="colorOnSurface">@color/ns_foreground</item>
        <item name="colorOnSurfaceVariant">@color/ns_muted_foreground</item>
        <item name="colorPrimary">@color/ns_brand_primary</item>
        <item name="shapeAppearanceOverlay">@style/AppAlertDialogShape</item>
        <item name="materialAlertDialogTitleTextStyle">@style/AppAlertDialogTitle</item>
    </style>

    <style name="AppAlertDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="AppAlertDialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="AppTheme" parent="AppThemeBase">
    </style>

    <!-- theme for action-bar -->
    <style name="NativeScriptToolbarStyleBase" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/ns_primary</item>
        <item name="theme">@style/ThemeOverlay.AppCompat.ActionBar</item>
        <item name="popupTheme">@style/ThemeOverlay.AppCompat</item>
    </style>

    <style name="NativeScriptToolbarStyle" parent="NativeScriptToolbarStyleBase">
    </style>
</resources>
